# Variables de entorno para desarrollo
NODE_ENV=development
PORT=3000

# Base de datos
DATABASE_PATH=./database/fila_boca.sqlite
DATABASE_LOGGING=true

# Queue-it configuración
QUEUE_IT_BASE_URL=https://bocajuniors.queue-it.net
QUEUE_IT_CUSTOMER_ID=bocajuniors
QUEUE_IT_EVENT_ID=e20251109adh
QUEUE_IT_API_URL=https://api.queue-it.net

# Verificación de filas
VERIFICATION_INTERVAL_MS=5000
MAX_CONCURRENT_VERIFICATIONS=100
VERIFICATION_TIMEOUT_MS=10000

# Logs
LOG_LEVEL=info
LOG_FILE=./logs/core.log

# CORS
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# WebSocket configuración
WEBSOCKET_CORS_ORIGIN=*
WEBSOCKET_TRANSPORTS=websocket,polling

# Detección de filas listas
READY_CONFIDENCE_THRESHOLD=0.8
CALCULANDO_MAX_SECONDS=120
MIN_PROGRESS_THRESHOLD=0.95
CRITICAL_SECONDS_THRESHOLD=60